{
  // Cloudflare Worker that lets the Rowian Tracker web/app use the AI meal chat
  // without each person needing their own API key. The Anthropic key is stored
  // as a Worker secret: `npx wrangler secret put ANTHROPIC_API_KEY`.
  "name": "rowian-tracker-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "vars": {
    // Sites allowed to call this Worker (comma-separated).
    "ALLOWED_ORIGINS": "https://rowian7.github.io,http://localhost:8081",
    "MODEL": "claude-opus-5-5"
  },
  // Each visitor (by IP) gets at most 10 AI replies per minute.
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } }]
}
